      },
      {
        "java_method": "failure",
        "class_name": "Result",
        "description": "建立失敗的 Result，支援自訂 errorCode+message 或傳入 ErrorCode enum（含可選自訂 message）",
        "complexity": "low"
      },
      {
        "java_method": "isFailure",
