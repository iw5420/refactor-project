      },
      {
        "java_method": "isNullOrEmpty",
        "class_name": "ValidationUtil",
        "description": "判斷字串是否為 null、空白或等於 'string'，是則回傳 true",
        "complexity": "low"
      },
      {
        "java_method": "isValidField",
        "class_name": "ValidationUtil",
        "description": "判斷字串是否為有效欄位值（非 null、非空白、非 'string'），是則回傳 true",
        "complexity": "low"
      },
      {
        "java_method": "findDistinctField",
        "class_name": "CollectionUtil",
        "description": "從 List 中以指定 mapper 函數取出字串欄位，過濾掉無效值後回傳去重後的字串列表",
        "complexity": "low"
      },
