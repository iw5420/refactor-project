[
  {
    "module": "common",
    "summary": "提供整個應用程式共用的基礎設施，包含統一的 HTTP 回應封裝（ResponseResult）、業務層結果封裝（Result）、錯誤碼規範介面（ErrorCode）、以及字串驗證（ValidationUtil）、集合處理（CollectionUtil）、隨機碼與字元轉換（CodeUtil）等工具類。這些 class 不屬於任何單一業務領域，而是被所有模組共同依賴的橫切關注點，歸為一個基礎模組以避免循環依賴。",
    "java_files": [
      "src/main/java/com/teachLanguage/model/common/api/ResponseResult.java",
      "src/main/java/com/teachLanguage/model/common/base/Result.java",
      "src/main/java/com/teachLanguage/model/common/enums/ErrorCode.java",
      "src/main/java/com/teachLanguage/utils/CodeUtil.java",
      "src/main/java/com/teachLanguage/utils/CollectionUtil.java",
      "src/main/java/com/teachLanguage/utils/ValidationUtil.java"
    ],
    "depends_on": [],
    "methods": [
      {
        "java_method": "error",
