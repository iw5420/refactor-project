n    name: str | None\n    email: str | None\n    card: str | None\n\nclass ResponseResultCreaterandomRs(BaseModel):\n    code: int | None\n    msg: str | None\n    data: CreaterandomRs | None\n\n```\n\n### app/schemas/candidate.py\n```python\n# 以下類別在 Java 端只有建構子、沒有被 module_list 追蹤到任何一般方法\n# （常見情況：自訂例外類別）。InterfaceSpec 無法表達這類定義，只能列出\n# 建構子簽名；實際 Python 對應寫法（Exception 子類別／dataclass／其他）\n# 請依下方標註的 Java 原始碼路徑自行判斷，這裡不假設任何基底類別。\n\n# ExamException（Java 原始碼：src/main/java/com/teachLanguage/exception/ExamException.java）\n# 建構子 1: ExamException(errorCode: ErrorCode, message: str)\n# 建構子 2: ExamException(message: str, errorCode: ErrorCode, data: Object)\n\n```\n\n### app/schemas/registration.py\n```python\nfrom __future__ import annotations\n\nfrom pydantic import BaseModel\n\nclass ResponseResultGetAllClassesRs(BaseModel):\n    code: int | None\n    msg: str | None\n    data: GetAllClassesRs | None\n\nclass ResponseResultGetAllGradeRs(BaseModel):\n    code: int | None\n    msg: str | None\n    data: GetAllGradeRs | None\n\nclass ResponseResultGetAllSchoolRs(BaseModel):\n    code: int | None\n    msg: str | None\n    data: GetAllSchoolRs | None\n\n```\n\n### app/schemas/exam.py\n```python\nfrom __future__ import annotations\n\nfrom pydantic import BaseModel\n\nclass SaveAnswerRq(BaseModel):\n    kind: str | None\n    randomId: str | None\n    typeNumber: str | None\n    partNumber: str | None\n    questionNumber: str | None\n    answer: str | None\n\nclass ResponseResultString(BaseModel):\n    code: int | None\n    msg: str | None\n    data: str | None\n\nclass GetExamRq(BaseModel):\n    year: str | None\n    grade: str | None\n    classes: str | None\n    kind: str | None\n    card: str | None\n    status: str | None\n    randomId: str | None\n\nclass ResponseResultGetExamRs(BaseModel):\n    code: int | None\n    msg: str | None\n    data: GetExamRs | None\n\nclass GetExamResultRq(BaseModel):\n    kind: str | None\n    randomId: str | None\n\nclass ResponseResultGetExamResultRs(BaseModel):\n    code: int | None\n    msg: str | None\n    data: GetExamResultRs | None\n\nclass GetSingleExamRq(BaseModel):\n    kind: str | None\n\nclass ResponseResultGetSingleExamRs(BaseModel):\n    code: int | None\n    msg: str | None\n    data: GetSingleExamRs | None\n\nclass ResponseResultGetAllExamRs(BaseModel):\n    code: int | None\n    msg: str | None\n    data: GetAllExamRs | None\n\nclass ResponseResultGetAllExamKindRs(BaseModel):\n    code: int | None\n    msg: str | None\n    data: GetAllExamKindRs | None\n\n```\n\n### app/schemas/grading.py\n```python\nfrom __future__ import annotations\n\nfrom pydantic import BaseModel\n\nclass LoginRq(BaseModel):\n    username: str | None\n    password: str | None\n\nclass ResponseResultBoolean(BaseModel):\n    code: int | None\n    msg: str | None\n    data: bool | None\n\nclass SaveScoreRq(BaseModel):\n    id: str | None\n    score: str | None\n\nclass ResponseResultVoid(BaseModel):\n    code: int | None\n    msg: str | None\n    data: object | None\n\nclass SaveTotalAndCommentRq(BaseModel):\n    kind: str | None\n    randomId: str | None\n    comment: str | None\n\nclass AnalyzeRq(BaseModel):\n    kind: str | None\n\nclass ResponseResultAnalyzeRs(BaseModel):\n    code: int | None\n    msg: str | None\n    data: AnalyzeRs | None\n\n```\n\n### app/schemas/grading.py\n```python\n# 以下類別在 Java 端只有建構子、沒有被 module_list 追蹤到任何一般方法\n# （常見情況：自訂例外類別）。InterfaceSpec 無法表達這類定義，只能列出\n# 建構子簽名；實際 Python 對應寫法（Exception 子類別／dataclass／其他）\n# 請依下方標註的 Java 原始碼路徑自行判斷，這裡不假設任何基底類別。\n\n# AuthException（Java 原始碼：src/main/java/com/teachLanguage/exception/AuthException.java）\n# 建構子 1: AuthException(errorCode: ErrorCode, message: str)\n# 建構子 2: AuthException(errorCode: ErrorCode, message: str, data: Object)\n\n```\n\n### app/core/database.py\n```python\nfrom sqlalchemy import create_engine\nfrom sqlalchemy.orm import sessionmaker, declarative_base\nimport os\n\nDATABASE_URL = os.environ[\"DATABASE_URL\"]\nengine = create_engine(DATABASE_URL)\nSessionLocal = sessionmaker(autocommit=False, autoflush=False, bind=engine)\nBase = declarative_base()\n\n\ndef get_db():\n    db = SessionLocal()\n    try:\n        yield db\n    except Exception:\n        db.rollback()\n        raise\n    finally:\n        db.close()\n```\n\n### app/main.py\n```python\nfrom fastapi import FastAPI\n\nfrom app.routers.candidate_router import router as candidate_router\nfrom app.routers.exam_router import router as exam_router\nfrom app.routers.file_router import router as file_router\nfrom app.routers.general_router import router as general_router\nfrom app.routers.grading_router import router as grading_router\nfrom app.routers.registration_router import router as registration_router\n\napp = FastAPI()\napp.include_router(candidate_router)\napp.include_router(exam_router)\napp.include_router(file_router)\napp.include_router(general_router)\napp.include_router(grading_router)\napp.include_router(registration_router)\n```\n",
